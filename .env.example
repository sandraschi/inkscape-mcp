# Inkscape MCP — Environment Configuration
# Copy this file to %LOCALAPPDATA%\ai.fleet.inkscape-mcp\.env and edit.
# The server reads these at startup. Restart after changing.

# --- Paths ---
# Path to Inkscape executable (auto-detected if not set)
# INKSCAPE_PATH=C:\Program Files\Inkscape\bin\inkscape.exe

# --- MCP Transport ---
# Transport mode: stdio (Claude Desktop), http (webapp/Tauri)
# MCP_TRANSPORT=http
# HTTP port when transport is http
MCP_PORT=11027
# Bind address
MCP_HOST=127.0.0.1

# --- Ollama (optional — for /api/generate-svg) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest

# --- Cloud LLM fallback (optional — used when Ollama is unreachable, or ---
# --- picked explicitly per-provider in AI Settings / /api/chat) ---
# Tried in this order by /api/generate-svg when Ollama is down: Gemini,
# OpenAI, DeepSeek, Anthropic, OpenRouter. Set any subset you have keys for.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Meta (Muse Spark) is NOT part of the automatic fallback — its cheap
# "-contributor" model variants opt your prompts into Meta's training
# pipeline; select it explicitly in AI Settings if you want that trade-off.
# META_API_KEY=

# --- Tauri (set automatically by backend.rs) ---
# INKSCAPE_TAURI=1
